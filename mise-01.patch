+mc cp local/flexile-development-private/test-file.txt /tmp/downloaded-file.txt
+if diff /tmp/test-file.txt /tmp/downloaded-file.txt > /dev/null; then
+  echo "✅ S3 upload/download test successful!"
+else
+  echo "❌ S3 test failed!"
+fi
