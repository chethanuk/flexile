+[[ "$CREATE_HTTP_CODE" =~ ^20[01]$ ]] && echo -e "${GREEN}✅ User created (HTTP $CREATE_HTTP_CODE)${NC}" || echo -e "${RED}❌ User creation failed (HTTP $CREATE_HTTP_CODE): ${CREATE_BODY}${NC}"
